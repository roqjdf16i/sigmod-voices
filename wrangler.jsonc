{
  "name": "sigmod-voices", "main": "src/worker.js", "compatibility_date": "2026-10-01",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "voices", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "observability": {"enabled": false}, "send_metrics": false
}
